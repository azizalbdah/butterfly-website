# Reference for the future Supabase-backed release, not active configuration.
# Never create a real .env inside this static site's served checkout.
# Store secrets in Supabase Edge Function secrets / protected host settings.
# Only the URL and publishable key may appear in a browser bundle.
PUBLIC_SUPABASE_URL=https://YOUR_PREVIEW_PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PREVIEW_PUBLISHABLE_KEY

# Administrative tools only, outside the public document root:
SUPABASE_PROJECT_REF=YOUR_PREVIEW_PROJECT_REF
# SUPABASE_ACCESS_TOKEN: supply securely through local CLI/secret settings.
# Database password: supply through a secure prompt, never a saved connection URL.
# Edge Functions obtain SUPABASE_URL and their server-only service-role secret from Supabase.

# Production must use a separate project, credentials and approved HTTPS host.
