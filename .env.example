# Reference for the Supabase-backed staff preview, not active configuration.
# Never create a real .env inside this static site's served checkout.
# Store secrets in Supabase Edge Function secrets / protected host settings.
# Only the URL and publishable key may appear in a browser bundle.
# These public values belong in staff/.env.local or the staff build environment.
VITE_SUPABASE_URL=https://YOUR_PREVIEW_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PREVIEW_PUBLISHABLE_KEY

# Administrative tools only, outside the public document root:
SUPABASE_PROJECT_REF=YOUR_PREVIEW_PROJECT_REF
# SUPABASE_ACCESS_TOKEN: supply securely through local CLI/secret settings.
# Database password: supply through a secure prompt, never a saved connection URL.
# Edge Functions obtain SUPABASE_URL and their server-only service-role secret from Supabase.
BUTTERFLY_STAFF_ORIGIN=https://YOUR_VERIFIED_STAFF_PREVIEW_HOST
BUTTERFLY_STAFF_REDIRECT_URL=https://YOUR_VERIFIED_STAFF_PREVIEW_HOST/staff/
# Comma-separated exact approved public HTTPS origins; no paths or wildcards.
BUTTERFLY_PUBLIC_ORIGINS=https://YOUR_VERIFIED_PUBLIC_PREVIEW_HOST
# BUTTERFLY_ENQUIRY_RATE_SECRET: generate >=32 random bytes in a private file and
# bind only as an Edge secret. Never place it in browser configuration or Git.

# Production must use a separate project, credentials and approved HTTPS host.
